--- /dev/null
+++ b/utils/tifo_adapter.py
@@ -0,0 +1,77 @@
+"""Minimal TIFO adapter used for the ACN+TIFO composition experiment."""
+
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+
+
+def fft_size(args):
+    ratio = float(getattr(args, "tifo_zero_pad_ratio", 0.0))
+    return int(args.seq_len) + int(int(args.seq_len) * ratio)
+
+
+def compute_stationarity_score(args, loader, device):
+    size = fft_size(args)
+    frequencies = size // 2 + 1
+    total = torch.zeros(frequencies, args.enc_in, device=device)
+    total2 = torch.zeros_like(total)
+    count = 0
+    with torch.no_grad():
+        for batch in loader:
+            x = batch[0].float().to(device)
+            # ACN's iTransformer applies this normalization before TIFO.
+            x = (x - x.mean(1, keepdim=True)) / torch.sqrt(
+                x.var(1, keepdim=True, unbiased=False) + 1e-5
+            )
+            amplitude = torch.abs(torch.fft.rfft(x, n=size, dim=1))
+            total += amplitude.sum(0)
+            total2 += amplitude.square().sum(0)
+            count += x.size(0)
+    if count == 0:
+        raise ValueError("cannot compute TIFO statistics from an empty loader")
+    mean = total / count
+    variance = (total2 / count - mean.square()).clamp_min(0.0)
+    return mean / (torch.sqrt(variance + 1e-5) + 1e-5)
+
+
+class TIFOAdapter(nn.Module):
+    def __init__(self, args, score):
+        super().__init__()
+        if score is None:
+            raise ValueError("ACN+TIFO requires a training-set stationarity score")
+        self.seq_len = int(args.seq_len)
+        self.fft_size = fft_size(args)
+        self.alpha = float(getattr(args, "tifo_residual_alpha", 1.0))
+        frequencies, channels = score.shape
+        if channels != args.enc_in or frequencies != self.fft_size // 2 + 1:
+            raise ValueError(f"invalid TIFO score shape: {tuple(score.shape)}")
+        self.register_buffer("stationarity_score", score.detach().clone().float())
+        hidden = int(getattr(args, "filter_dim", 256))
+        dropout = float(getattr(args, "tifo_dropout", 0.3))
+
+        def mlp():
+            return nn.Sequential(
+                nn.Linear(frequencies, hidden),
+                nn.RReLU(),
+                nn.Dropout(dropout),
+                nn.Linear(hidden, frequencies),
+            )
+
+        self.linear_r = mlp()
+        self.linear_i = mlp()
+
+    def forward(self, x):
+        score = self.stationarity_score.transpose(0, 1)
+        wr = self.linear_r(score).transpose(0, 1)
+        wi = self.linear_i(score).transpose(0, 1)
+        spectrum = torch.fft.rfft(x, n=self.fft_size, dim=1)
+        weighted = torch.complex(spectrum.real * wr, spectrum.imag * wi)
+        filtered = torch.fft.irfft(weighted, n=self.fft_size, dim=1)
+        filtered = filtered[:, : self.seq_len, :]
+        return x + self.alpha * (filtered - x)
+
+
+def build_tifo_adapter(args, score):
+    with torch.random.fork_rng(devices=[]):
+        return TIFOAdapter(args, score)
